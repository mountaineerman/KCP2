<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- =============================================================== -->
    <!-- Glass Cockpit Descriptions -->
    <!-- =============================================================== -->
    <!-- TODO: Add android:visibility="gone" ... -->
    <View
        android:id="@+id/TL_Button_Hint"
        android:layout_width="@dimen/button_hint_rectangle_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:background="@drawable/shaded_rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="0dp"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/GlassCockpit_TL"
        android:layout_width="@dimen/glass_cockpit_textbox_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:gravity="center_vertical"
        android:text="(TL)"
        android:textSize="@dimen/glass_cockpit_text_size"
        android:paddingLeft="@dimen/glass_cockpit_text_padding"
        android:background="@color/glass_cockpit_background_dark_grey"
        app:layout_constraintBottom_toBottomOf="@+id/TL_Button_Hint"
        app:layout_constraintStart_toEndOf="@+id/TL_Button_Hint"
        android:layout_marginStart="0dp" />


    <View
        android:id="@+id/CL_Button_Hint"
        android:layout_width="@dimen/button_hint_rectangle_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:background="@drawable/shaded_rectangle"
        android:backgroundTint="#FCD12A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="0dp"
        android:layout_marginBottom="155dp" />

    <TextView
        android:id="@+id/GlassCockpit_CL"
        android:layout_width="@dimen/glass_cockpit_textbox_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:layout_marginStart="0dp"
        android:gravity="center_vertical"
        android:text="KMega\nDiagnostic\nMode"
        android:textSize="@dimen/glass_cockpit_text_size"
        android:paddingLeft="@dimen/glass_cockpit_text_padding"
        android:background="@color/glass_cockpit_background_dark_grey"
        app:layout_constraintBottom_toBottomOf="@+id/CL_Button_Hint"
        app:layout_constraintStart_toEndOf="@+id/CL_Button_Hint" />


    <View
        android:id="@+id/BL_Button_Hint"
        android:layout_width="@dimen/button_hint_rectangle_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:background="@drawable/shaded_rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="0dp"
        android:layout_marginBottom="5dp" />

    <TextView
        android:id="@+id/GlassCockpit_BL"
        android:layout_width="@dimen/glass_cockpit_textbox_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:layout_marginStart="0dp"
        android:gravity="center_vertical"
        android:text="(BL)"
        android:textSize="@dimen/glass_cockpit_text_size"
        android:paddingLeft="@dimen/glass_cockpit_text_padding"
        android:background="@color/glass_cockpit_background_dark_grey"
        app:layout_constraintBottom_toBottomOf="@+id/BL_Button_Hint"
        app:layout_constraintStart_toEndOf="@+id/BL_Button_Hint" />


    <View
        android:id="@+id/TR_Button_Hint"
        android:layout_width="@dimen/button_hint_rectangle_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:background="@drawable/shaded_rectangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/TL_Button_Hint"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/GlassCockpit_TR"
        android:layout_width="@dimen/glass_cockpit_textbox_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:layout_marginEnd="0dp"
        android:gravity="center_vertical|right"
        android:text="(TR)"
        android:textSize="@dimen/glass_cockpit_text_size"
        android:paddingRight="@dimen/glass_cockpit_text_padding"
        android:background="@color/glass_cockpit_background_dark_grey"
        app:layout_constraintBottom_toBottomOf="@+id/TL_Button_Hint"
        app:layout_constraintEnd_toStartOf="@+id/TR_Button_Hint" />


    <View
        android:id="@+id/CR_Button_Hint"
        android:layout_width="@dimen/button_hint_rectangle_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:background="@drawable/shaded_rectangle"
        android:backgroundTint="#FCD12A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/CL_Button_Hint"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/GlassCockpit_CR"
        android:layout_width="@dimen/glass_cockpit_textbox_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:gravity="center_vertical|right"
        android:paddingRight="@dimen/glass_cockpit_text_padding"
        android:text="KKIM\nDiagnostic\nMode"
        android:textSize="@dimen/glass_cockpit_text_size"
        android:background="@color/glass_cockpit_background_dark_grey"
        app:layout_constraintBottom_toBottomOf="@+id/CR_Button_Hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/CR_Button_Hint" />


    <View
        android:id="@+id/BR_Button_Hint"
        android:layout_width="@dimen/button_hint_rectangle_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:background="@drawable/shaded_rectangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/BL_Button_Hint"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/GlassCockpit_BR"
        android:layout_width="@dimen/glass_cockpit_textbox_width"
        android:layout_height="@dimen/button_hint_and_glass_cockpit_textbox_height"
        android:gravity="center_vertical|right"
        android:paddingRight="@dimen/glass_cockpit_text_padding"
        android:text="Graceful\nShutdown"
        android:textSize="@dimen/glass_cockpit_text_size"
        android:background="@color/glass_cockpit_background_dark_grey"
        app:layout_constraintBottom_toBottomOf="@+id/BR_Button_Hint"
        app:layout_constraintEnd_toStartOf="@+id/BR_Button_Hint" />

    <!-- =============================================================== -->
    <!-- Core Content (Center) -->
    <!-- =============================================================== -->
    <TextView
        android:id="@+id/centerHeader1"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="APO (m):"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toEndOf="@+id/GlassCockpit_TL"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/centerBody1_APO"
        android:layout_width="@dimen/center_readings_main_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toEndOf="@+id/centerHeader1"
        app:layout_constraintTop_toTopOf="@+id/centerHeader1" />



    <TextView
        android:id="@+id/centerHeader2"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="ALT (m):"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader1"
        android:layout_marginTop="@dimen/center_readings_vertical_spacing" />

    <TextView
        android:id="@+id/centerBody2_ALT"
        android:layout_width="@dimen/center_readings_main_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toEndOf="@+id/centerHeader2"
        app:layout_constraintTop_toTopOf="@+id/centerHeader2" />



    <TextView
        android:id="@+id/centerHeader3"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="PER (m):"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader2"
        android:layout_marginTop="@dimen/center_readings_vertical_spacing" />

    <TextView
        android:id="@+id/centerBody3_PER"
        android:layout_width="@dimen/center_readings_main_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toEndOf="@+id/centerHeader3"
        app:layout_constraintTop_toTopOf="@+id/centerHeader3" />



    <TextView
        android:id="@+id/centerHeader4"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="ttA/P:"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader3"
        android:layout_marginTop="@dimen/center_readings_vertical_spacing" />

    <TextView
        android:id="@+id/centerBody4_ttAP"
        android:layout_width="@dimen/center_readings_main_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toEndOf="@+id/centerHeader4"
        app:layout_constraintTop_toTopOf="@+id/centerHeader4" />



    <TextView
        android:id="@+id/centerHeader5"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="Speed(m/s):"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader4"
        android:layout_marginTop="@dimen/center_readings_vertical_spacing" />

    <TextView
        android:id="@+id/centerBody5_Speed"
        android:layout_width="@dimen/center_readings_main_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toEndOf="@+id/centerHeader5"
        app:layout_constraintTop_toTopOf="@+id/centerHeader5" />



    <TextView
        android:id="@+id/centerHeader6"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="I (A):"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader5" />

    <TextView
        android:id="@+id/centerBody6_Current"
        android:layout_width="@dimen/center_readings_secondary_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toEndOf="@+id/centerHeader6"
        app:layout_constraintTop_toTopOf="@+id/centerHeader6" />



    <TextView
        android:id="@+id/centerHeader7"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="Exceptions:"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader6"
        android:layout_marginTop="@dimen/center_readings_vertical_spacing" />

    <TextView
        android:id="@+id/centerBody7_Exceptions"
        android:layout_width="@dimen/center_readings_secondary_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_dark"
        app:layout_constraintStart_toEndOf="@+id/centerHeader7"
        app:layout_constraintTop_toTopOf="@+id/centerHeader7" />



    <TextView
        android:id="@+id/centerHeader8"
        android:layout_width="@dimen/center_readings_header_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="BATT (%):"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_header_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toStartOf="@+id/centerHeader1"
        app:layout_constraintTop_toBottomOf="@+id/centerHeader7"
        android:layout_marginTop="@dimen/center_readings_vertical_spacing" />

    <TextView
        android:id="@+id/centerBody8_BATTERY"
        android:layout_width="@dimen/center_readings_secondary_body_width"
        android:layout_height="@dimen/center_readings_height"
        android:typeface="monospace"
        android:text="no data"
        android:gravity="center_vertical|right"
        android:textSize="@dimen/center_readings_body_text_size"
        android:background="@color/center_readings_background_light"
        app:layout_constraintStart_toEndOf="@+id/centerHeader8"
        app:layout_constraintTop_toTopOf="@+id/centerHeader8" />



    <!-- =============================================================== -->
    <!-- Launch Tools/Info -->
    <!-- =============================================================== -->

    <Button
        android:id="@+id/LaunchAndResetButton"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:text="Launch"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/button_green"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="0dp" />

    <TextView
        android:id="@+id/KPhoStatus"
        android:layout_width="355dp"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:text="KPho Status: Idle"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/LaunchAndResetButton"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="@+id/LaunchAndResetButton" />

    <Button
        android:id="@+id/exitButton"
        android:layout_width="90dp"
        android:layout_height="50dp"
        android:text="Exit"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/button_blue"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/centerBody7_Exceptions"
        app:layout_constraintTop_toTopOf="@+id/centerHeader7" />

</androidx.constraintlayout.widget.ConstraintLayout>